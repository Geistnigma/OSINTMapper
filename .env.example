# ═══ OSINTMapper v2.2 — Configuration ═══
# Copy to .env and edit ALL values marked CHANGE_ME

# Database (SQLite — relative to server/)
DATABASE_URL="file:./data/osintmapper.db"

# Server
PORT=4444
BIND_HOST=0.0.0.0
NODE_ENV=production

# SECURITY: Generate a strong secret! Run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Client build path (relative to server/)
CLIENT_DIST=../client/dist

# CORS (production) — leave empty for same-origin, or set your domain
# CORS_ORIGIN=https://yourdomain.com
